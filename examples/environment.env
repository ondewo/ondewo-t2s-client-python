# ---------------------------------------------------------------------------
# ONDEWO T2S client SDK — example configuration template.
#
# This is a NON-SECRET template. Copy real values in locally, but never commit
# secrets. Every example under examples/ loads this file via python-dotenv
# (path relative to the script) and reads the variables below with os.getenv.
# ---------------------------------------------------------------------------

# --- Connection ---
# Hostname/IP and port of the ONDEWO T2S gRPC server.
ONDEWO_HOST=localhost
ONDEWO_PORT=50555

# --- Secure channel (TLS) ---
# Whether to open a secure (TLS) gRPC channel. true/false.
ONDEWO_USE_SECURE_CHANNEL=false
# Path to a PEM certificate file for the secure channel. Leave blank for an
# insecure channel. Only read when ONDEWO_USE_SECURE_CHANNEL=true.
ONDEWO_GRPC_CERT=

# --- Keycloak headless offline-token auth (D18) ---
# Base URL of the Keycloak server (the part before /realms/<realm>).
KEYCLOAK_URL=
# Keycloak realm name.
KEYCLOAK_REALM=ondewo-ccai-platform
# Public SDK client id used for the ROPC grant (no client secret is sent).
KEYCLOAK_CLIENT_ID=ondewo-nlu-cai-sdk-public
# Technical-user (2FA-exempt) credentials for the ROPC grant.
KEYCLOAK_USER_NAME=
KEYCLOAK_PASSWORD=
# Whether to verify the Keycloak server's TLS certificate. true/false.
KEYCLOAK_VERIFY_SSL=true
